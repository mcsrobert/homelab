{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  packageRules: [
    {
      groupName: 'Flux CD',
      group: {commitMessageTopic: '{{{groupName}}} group'},
      matchDepNames: ['/fluxcd/', 'flux2'],
    },
    {
      groupName: 'Plugin Barman Cloud',
      group: {commitMessageTopic: '{{{groupName}}} group'},
      matchDepNames: ['/plugin-barman-cloud/'],
    },
    {
      groupName: 'ansible-lint',
      group: {commitMessageTopic: '{{{groupName}}} group'},
      matchDepNames: ['/ansible-lint/'],
    },
    {
      groupName: 'flate',
      group: {commitMessageTopic: '{{{groupName}}} group'},
      matchDepNames: ['/home-operations/flate/'],
    },
    {
      groupName: 'markdownlint-cli2',
      group: {commitMessageTopic: '{{{groupName}}} group'},
      matchDepNames: ['/markdownlint-cli2/'],
    },
    {
      groupName: 'OpenBao',
      group: {commitMessageTopic: '{{{groupName}}} group'},
      matchDepNames: ['/openbao/'],
    },
    {
      groupName: 'Renovate',
      group: {commitMessageTopic: '{{{groupName}}} group'},
      matchPackageNames: [
        'renovate/renovate',
        'renovatebot/pre-commit-hooks',
      ],
    },
  ]
}
