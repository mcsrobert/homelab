{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  packageRules: [
    {
      groupName: 'Flux CD',
      matchDepNames: ['/fluxcd/'],
      group: {commitMessageTopic: '{{{groupName}}} group'},
    },
    {
      groupName: 'Plugin Barman Cloud',
      matchDepNames: ['/plugin-barman-cloud/'],
      group: {commitMessageTopic: '{{{groupName}}} group'},
    },
    {
      groupName: 'Renovate',
      matchDepNames: ['/renovate/'],
      group: {commitMessageTopic: '{{{groupName}}} group'},
    },
  ]
}
