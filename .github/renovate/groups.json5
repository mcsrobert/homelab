{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  packageRules: [
    {
      groupName: 'Flux CD',
      group: {commitMessageTopic: '{{{groupName}}} group'},
      matchDepNames: ['/fluxcd/', 'flux2'],
    },
    {
      groupName: 'Plugin Barman Cloud',
      group: {commitMessageTopic: '{{{groupName}}} group'},
      matchDepNames: ['/plugin-barman-cloud/'],
    },
    {
      groupName: 'ansible-lint',
      group: {commitMessageTopic: '{{{groupName}}} group'},
      matchDepNames: ['/ansible-lint/'],
    },
    {
      groupName: 'flate',
      group: {commitMessageTopic: '{{{groupName}}} group'},
      matchDepNames: ['/home-operations/flate/'],
    },
    {
      groupName: 'markdownlint-cli2',
      group: {commitMessageTopic: '{{{groupName}}} group'},
      matchDepNames: ['/markdownlint-cli2/'],
    },
    {
      groupName: 'OpenBao',
      group: {commitMessageTopic: '{{{groupName}}} group'},
      matchDepNames: ['/openbao/'],
    },
    {
      groupName: 'Kyverno',
      group: {commitMessageTopic: '{{{groupName}}} group'},
      matchDepNames: ['ghcr.io/kyverno/charts/kyverno', '/^reg\\.kyverno\\.io\\/kyverno\\//'],
    },
    {
      groupName: 'Policy Reporter',
      group: {commitMessageTopic: '{{{groupName}}} group'},
      matchDepNames: ['/kyverno\\/(charts\\/)?policy-reporter/'],
    },
    {
      groupName: 'T3 Code tools',
      group: {commitMessageTopic: '{{{groupName}}} group'},
      matchPackageNames: [
        '@anthropic-ai/claude-code',
        '@openai/codex',
        'cli/cli',
        'pingdotgg/t3code',
      ],
      schedule: ['on friday after 02:00 and before 04:00'],
    },
    {
      groupName: 'Renovate {{newMajor}}.{{newMinor}}.x',
      group: {
        branchTopic: 'renovate-{{newMajor}}.{{newMinor}}.x',
        commitMessageTopic: '{{{groupName}}} group',
      },
      matchPackageNames: [
        'renovate/renovate',
        'renovatebot/pre-commit-hooks',
      ],
    },
  ]
}
