{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  packageRules: [
    {
      description: 'Falco artifacts registry syntax does not match helm-values manager',
      matchManagers: ['helm-values'],
      matchFileNames: ['kubernetes/**/falco*/**/{rulesfile,plugins}.yaml'],
      enabled: false,
    },
    {
      description: 'Use 5 part versioning scheme for CNPG VectorChord image',
      matchDatasources: ['docker'],
      matchPackageNames: ['ghcr.io/tensorchord/cloudnative-vectorchord'],
      versioning: 'regex:^(?<major>\\d+)\\.(?<minor>\\d+)-(?<patch>\\d+)\\.(?<build>\\d+)\\.(?<revision>\\d+)$',
      pinDigests: true,
    },
    {
      description: 'Skip first minor release for Longhorn',
      matchDatasources: ['helm'],
      matchPackageNames: ['longhorn'],
      matchNewValue: '/^\\d+\\.\\d+\\.0$/',
      enabled: false,
    },
    {
      description: 'Skip first monthly release for Home Assistant',
      matchDatasources: ['docker'],
      matchPackageNames: ['ghcr.io/home-operations/home-assistant'],
      matchNewValue: '/^\\d{4}\\.\\d+\\.0$/',
      enabled: false,
    },
    {
      description: 'Keep Python on 3.13 until ansible supports newer versions',
      matchManagers: ['mise'],
      matchDepNames: ['python'],
      allowedVersions: '<3.14',
    },
  ]
}
