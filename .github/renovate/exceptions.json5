{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  packageRules: [
    {
      description: 'Falco artifacts registry syntax does not match helm-values manager',
      matchManagers: ['helm-values'],
      matchFileNames: ['kubernetes/**/falco*/**/{rulesfile,plugins}.yaml'],
      enabled: false,
    },
    {
      description: 'Use 5 part versioning scheme for CNPG VectorChord image',
      matchDatasources: ['docker'],
      matchPackageNames: ['ghcr.io/tensorchord/cloudnative-vectorchord'],
      versioning: 'regex:^(?<major>\\d+)\\.(?<minor>\\d+)-(?<patch>\\d+)\\.(?<build>\\d+)\\.(?<revision>\\d+)$',
      pinDigests: true,
    },
  ]
}
