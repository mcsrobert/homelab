{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  customManagers: [
    {
      description: 'Update YAML schema for kubernetes manifests based on k3s version',
      customType: 'regex',
      managerFilePatterns: ['/\\.ya?ml$/'],
      matchStrings: ['yannh/kubernetes-json-schema/master/(?<currentValue>v\\d+\\.\\d+\\.\\d+)'],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'kubernetes/kubernetes',
      packageNameTemplate: 'k3s-io/k3s',
      extractVersionTemplate: '^(?<version>v\\d+\\.\\d+\\.\\d+)(\\+k3s\\d+)?$',
    },
    {
      description: 'Read the Python client version Y.Z.P as Kubernetes 1.Y.Z plus client patch P, so a new Kubernetes minor is a minor update. Pre-releases do not match and are skipped',
      customType: 'regex',
      managerFilePatterns: ['/requirements\\.txt$/'],
      matchStrings: ['(^|\\n)kubernetes==(?<currentValue>\\d+\\.\\d+\\.\\d+)'],
      datasourceTemplate: 'pypi',
      depNameTemplate: 'kubernetes',
      versioningTemplate: 'regex:^(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)$',
    },
  ],
  packageRules: [
    {
      description: 'Use Kubernetes versioning for schema URLs sourced from k3s releases',
      matchDepNames: ['kubernetes/kubernetes'],
      versioning: 'semver-coerced',
    },
    {
      description: 'Treat the +k3sN suffix as a real version component',
      matchDepNames: ['k3s-io/k3s'],
      versioning: 'regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?<prerelease>-rc\\d+)?\\+k3s(?<build>\\d+)$',
    },
    {
      description: 'Only offer kubectl versions that k3s has released',
      matchManagers: ['mise'],
      matchDepNames: ['kubectl'],
      overridePackageName: 'k3s-io/k3s',
      extractVersion: '^v(?<version>\\d+\\.\\d+\\.\\d+)\\+k3s\\d+$',
    },
    {
      description: 'Leave the Python client to the custom manager above. Its pep440 versioning would make a new Kubernetes minor a major update, and regex versioning would drop the == on update',
      matchManagers: ['pip_requirements'],
      matchDepNames: ['kubernetes'],
      enabled: false,
    },
    {
      description: 'Upgrade k3s, kubectl, the Python client and schemas together. Automerge is excluded in merge-schedule.json5',
      groupName: 'k3s',
      group: {commitMessageTopic: '{{{groupName}}} group'},
      matchDepNames: [
        'k3s-io/k3s',
        'kubernetes/kubernetes',
        'kubectl',
        'kubernetes',
      ],
    },
  ],
}
