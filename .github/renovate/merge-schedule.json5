{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  packageRules: [
    {
      description: 'Automatically schedule and merge non-major releases',
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      excludePackageNames: ['longhorn'],
      automerge: true,
      automergeSchedule: ['on tuesday and wednesday after 09:00 and before 18:00'],
      schedule: ['on thursday'],
      addLabels: ['renovate/automerge'],
    },
    {
      description: 'Add a prefix to avoid conflicts with other updates',
      matchUpdateTypes: ['pin'],
      additionalBranchPrefix: 'pin-',
    },
    {
      description: 'Skip first minor release for Longhorn',
      matchPackageNames: ['longhorn'],
      matchNewValue: '/^\\d+\\.\\d+\\.0$/',
      enabled: false,
    },
    {
      description: 'Skip first monthly release for Home Assistant',
      matchPackageNames: ['ghcr.io/home-operations/home-assistant'],
      matchNewValue: '/^\\d{4}\\.\\d+\\.0$/',
      enabled: false,
    },
  ]
}
