{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    ':separateMajorReleases',
  ],
  packageRules: [
    {
      description: 'Automatically schedule and merge releases',
      matchUpdateTypes: ['minor', 'patch', 'digest', 'pin'],
      matchPackageNames: [
        '!k3s-io/k3s',
        '!kubernetes',
        '!kubernetes/kubernetes',
        '!longhorn',
        '!ghcr.io/tensorchord/cloudnative-vectorchord',
      ],
      automerge: true,
      schedule: ['after 02:00 and before 04:00'],
      updateNotScheduled: false,
      addLabels: ['renovate/automerge'],
    },
    {
      description: 'Only schedule frequent releases once a week',
      matchPackageNames: [
        'ghcr.io/grafana-community/helm-charts/grafana',
        'renovate/renovate',
        'renovatebot/pre-commit-hooks',
        'jdx/mise',
        '@anthropic-ai/claude-code',
        '@openai/codex',
        'cli/cli',
        'pingdotgg/t3code',
      ],
      schedule: ['on friday after 02:00 and before 04:00'],
    }
  ]
}
