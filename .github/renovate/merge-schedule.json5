{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    ':separateMajorReleases',
  ],
  packageRules: [
    {
      description: 'Automatically schedule and merge releases',
      matchUpdateTypes: ['minor', 'patch', 'digest', 'pin'],
      matchPackageNames: [
        '!k3s-io/k3s',
        '!kubernetes',
        '!kubernetes/kubernetes',
        '!longhorn',
        // Extension upgrades require SQL updates and reindexing.
        '!ghcr.io/tensorchord/cloudnative-vectorchord',
      ],
      automerge: true,
      automergeSchedule: ['every weekday after 09:00 and before 18:00'],
      schedule: ['after 20:00 and before 22:00'],
      addLabels: ['renovate/automerge'],
    },
    {
      description: 'Only schedule frequent releases once a week',
      matchPackageNames: [
        'ghcr.io/grafana-community/helm-charts/grafana',
        'renovate/renovate',
        'renovatebot/pre-commit-hooks',
        'jdx/mise',
        '@anthropic-ai/claude-code',
      ],
      schedule: ['on sunday after 20:00 and before 22:00'],
    }
  ]
}
