{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    ':separateMultipleMajorReleases',
  ],
  packageRules: [
    {
      description: 'Keep separate minor release streams for selected fast-moving packages',
      matchPackageNames: ['ghcr.io/grafana-community/helm-charts/grafana'],
      separateMultipleMinor: true,
    },
    {
      description: 'Automatically schedule and merge releases',
      matchUpdateTypes: ['minor', 'patch', 'digest', 'pin'],
      matchPackageNames: [
        '!k3s-io/k3s',
        '!kubernetes',
        '!kubernetes/kubernetes',
        '!longhorn',
        '!ghcr.io/tensorchord/cloudnative-vectorchord',
      ],
      automerge: true,
      schedule: ['after 02:00 and before 04:00'],
      addLabels: ['renovate/automerge'],
    },
    {
      description: 'Merge the T3 Code image without a soak',
      matchPackageNames: ['ghcr.io/mcsrobert/t3-code'],
      schedule: ['at any time'],
      addLabels: ['renovate/skip-soak'],
    },
  ],
}
