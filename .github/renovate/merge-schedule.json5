{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  packageRules: [
    {
      description: 'Automatically schedule and merge non-major releases',
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      excludePackageNames: [
        'k3s-io/k3s',
        'kubernetes/kubernetes',
        'longhorn',
      ],
      automerge: true,
      automergeSchedule: ['every weekday after 09:00 and before 18:00'],
      addLabels: ['renovate/automerge'],
    },
  ]
}
