---
apiVersion: v1
kind: Pod
metadata:
  name: kube-vip
  namespace: kube-system
spec:
  containers:
    - name: kube-vip
      image: ghcr.io/kube-vip/kube-vip:v1.3.1@sha256:1962f9daf226503f7e6b107f595cb28b7917fd2d0113957075e19a3e5a6c1e33
      imagePullPolicy: IfNotPresent
      args:
        - manager
      env:
        - name: vip_arp
          value: "true"
        - name: port
          value: "{{ api_port }}"
        - name: vip_nodename
          valueFrom:
            fieldRef:
              fieldPath: spec.nodeName
        - name: vip_address
          value: "{{ api_endpoint }}"
        - name: vip_subnet
          value: "24"
        - name: vip_interface
          value: "{{ ansible_facts.default_ipv4.interface }}"
        - name: cp_enable
          value: "true"
        - name: cp_namespace
          value: "kube-system"
        - name: vip_leaderelection
          value: "true"
        # - name: prometheus_server
        #   value: :2112
      resources:
        requests:
          cpu: 10m
          memory: 24Mi
        limits:
          memory: 32Mi
      securityContext:
        capabilities:
          drop:
            - ALL
          add:
            - NET_ADMIN
            - NET_RAW
      volumeMounts:
        - name: kubeconfig
          mountPath: /etc/kubernetes/admin.conf
  hostAliases:
    - hostnames:
        - kubernetes
      ip: 127.0.0.1
  hostNetwork: true
  volumes:
    - name: kubeconfig
      hostPath:
        path: /etc/rancher/k3s/k3s.yaml
        # site.yaml writes this manifest before k3s creates k3s.yaml. Without
        # a type, containerd would create a directory at the missing path and
        # k3s could no longer write its kubeconfig there. With File, kubelet
        # retries the pod until k3s has written the file.
        type: File
